rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function signedInMemberIn(data) {
      return signedIn()
        && data.memberEmails is list
        && request.auth.token.email in data.memberEmails;
    }

    match /families/{familyId} {
      allow create: if signedInMemberIn(request.resource.data)
        && request.resource.data.memberEmails.size() >= 1
        && request.resource.data.memberEmails.size() <= 4;

      allow read: if signedInMemberIn(resource.data);

      allow update: if signedInMemberIn(resource.data)
        && signedInMemberIn(request.resource.data)
        && request.resource.data.memberEmails.size() >= 1
        && request.resource.data.memberEmails.size() <= 4;

      allow delete: if false;
    }
  }
}
